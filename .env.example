# cmd/webapp infra/deploy config (12-factor). Copy to .env (gitignored) and edit.
# Precedence: explicit CLI flag  >  real env var  >  this file  >  built-in default.
# Only INFRA/deploy settings live here. Business/behaviour config (prompts, policies,
# sampling, budgets, profile, model binding) lives in the governed datastore DB.

# HTTP listen address (loopback)
WEBAPP_ADDR=127.0.0.1:8789

# Drop folder — inbox/outbox/processed/logs AND the SQLite DBs live here.
# Leave unset to default to ~/Desktop/Email-to-Calendar. If set, use an ABSOLUTE
# path (no ~ expansion).
# WEBAPP_DROP=/Users/you/Desktop/Email-to-Calendar

# Egress allowlist for action/handbook links (comma-separated; empty = deny all).
WEBAPP_ALLOW=schools.nyc.gov,nyc.gov,ps51eliashowe.org,schoolsaccount.nyc

# MicroVM vsock bridge for in-sandbox fetches. Use 127.0.0.1:5050 if macOS AirPlay
# Receiver owns :5000 (and pass launchvm -bridge 127.0.0.1:5050 to match).
MICROVM_URL=http://127.0.0.1:5000

# gouncer gateway chat-completions endpoint (also the health-check host).
GATEWAY_URL=http://127.0.0.1:4000/v1/chat/completions
